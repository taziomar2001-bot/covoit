# Copy this file to .env.local for local dev, and set the same vars in Netlify.
# These are the ONLY secrets the frontend needs. The anon key is safe to expose
# in the browser — Row-Level Security in Postgres is what actually protects data.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. Leave blank to use the free keyless Photon/OSM geocoder.
# Add a MapTiler key later for sharper address autocomplete — no code change needed.
VITE_MAPTILER_KEY=
